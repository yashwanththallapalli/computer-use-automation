# Copy to .env and fill in. Needed only for the discovery agent (scripts/run_discovery.py,
# scripts/build_artifact.py) -- replay, guardrails, evidence, escalation, and the catalog
# all run with no key and no live LLM.

ANTHROPIC_API_KEY=sk-ant-...

# Discovery agent model. claude-opus-5 (default) for best tool-use reliability;
# claude-sonnet-5 cuts token cost ~2.5x if runs are clean.
CUA_MODEL=claude-opus-5

# Mock target app (defaults shown; only needed if you're running it on a different port)
BANKAPP_BASE_URL=http://127.0.0.1:5001
